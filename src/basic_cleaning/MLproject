name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:
      input_artifact:
        description: Input W&B artifact containing the raw sample CSV, with version or alias
        type: string
      output_artifact:
        description: Name of the cleaned CSV artifact to upload to W&B
        type: string
      output_type:
        description: W&B artifact type for the cleaned dataset
        type: string
      output_description:
        description: Description stored on the cleaned dataset artifact
        type: string
      min_price:
        description: Minimum nightly price to keep, inclusive
        type: float
      max_price:
        description: Maximum nightly price to keep, inclusive
        type: float

    command: >-
        python run.py --input_artifact {input_artifact} --output_artifact {output_artifact} --output_type {output_type} --output_description {output_description} --min_price {min_price} --max_price {max_price}
